# Server Port
PORT=5000
NODE_ENV=production

# Database Connection (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=stock_market_application
DB_PORT=3306

# Authentication & Security
JWT_SECRET=indian_stock_market_jwt_secret_key_2026
CORS_ORIGIN=*

# Payment Gateway (Razorpay Integration)
RAZORPAY_KEY_ID=rzp_test_xxxxxx
RAZORPAY_KEY_SECRET=xxxxxx

# Email Delivery Configuration (PHPMailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME=Stock Market App

# SMS OTP Delivery Configuration (Options: fast2sms | twilio | log)
SMS_PROVIDER=fast2sms

# Fast2SMS Credentials (for Indian Mobile Numbers)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio Credentials (Alternative International SMS Provider)
TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# OTP System Settings
OTP_EXPIRY_MINUTES=10
OTP_COOLDOWN_SECONDS=30
