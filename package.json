{
  "name": "indian-stock-market-platform",
  "version": "1.0.0",
  "description": "Full-Stack Indian Stock Market Trading Platform for Render Deployment",
  "main": "server/server.js",
  "scripts": {
    "install:client": "npm install --prefix client",
    "install:server": "npm install --prefix server",
    "build:client": "npm run build --prefix client",
    "build": "npm run install:client && npm run build:client && npm run install:server",
    "start": "node server/server.js",
    "dev": "concurrently \"npm run dev --prefix client\" \"node server/server.js\""
  },
  "keywords": [
    "indian-stock-market",
    "nse",
    "bse",
    "render-deployment",
    "tradingview-charts",
    "react-express"
  ],
  "author": "Sneh Patel",
  "license": "ISC"
}
